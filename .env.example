# --- Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server only, never expose

# --- Claude API (console.anthropic.com -> API Keys) ---
ANTHROPIC_API_KEY=sk-ant-your-key
CLAUDE_MODEL=claude-sonnet-4-6

# --- Deploy pipeline ---
VERCEL_TOKEN=your-vercel-token        # vercel.com -> Settings -> Tokens
GITHUB_TOKEN=                          # optional: GitHub -> Settings -> Developer settings -> PAT (repo scope)

# --- Free tier limits per user per day ---
FREE_DAILY_BUILDS=3
FREE_DAILY_PLANS=3

# --- Sandbox execution (optional — get a free key at e2b.dev, no card needed) ---
# When unset, generated sites fall back to the static iframe preview gracefully.
E2B_API_KEY=
