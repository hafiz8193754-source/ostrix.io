# --- Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Optional for patient and doctor routes. Those use the anon key plus the
# caller's session, and RLS applies. Required for account deletion,
# /api/admin/doctors (verification), and sweeps that update other doctors.
# Those return 503 "Server not fully configured" when this is unset.
# Apply supabase/migrations/20261022120000_doctor_owner_policies.sql so
# bookings, prescriptions, presence, and prescription PDFs work without it.
SUPABASE_SERVICE_ROLE_KEY=

# Public origin Twilio uses to fetch TwiML and status callbacks.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- xAI Grok (console.x.ai -> API Keys) ---
# OpenAI-compatible chat completions: https://api.x.ai/v1
# XAI_MODEL is optional; when unset the app uses grok-4.7.
XAI_API_KEY=xai-your-key
XAI_MODEL=grok-4.7

# --- Claude fallback (optional) ---
# Used only when XAI_API_KEY is unset and ANTHROPIC_API_KEY is set.
# ANTHROPIC_API_KEY=sk-ant-your-key
# CLAUDE_MODEL=claude-sonnet-4-6

# --- Twilio Voice (optional until a doctor places a call) ---
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
